#STUDENT MARKS - FLOW CONTROL STATEMENT

marks = [85, 72, 0, 91, 35, 100, 150, 78]

for mark in marks:
    #Break: Stop the loop if mark is invalid.
    if mark > 100:
        print('Invalid Mark', mark)
        break
    #Continue: Skip the Student if absent
    if mark == 0:
        print('Student is Absen')
        continue
    #Pass: Do nothing for marks, below 40 'just it will pass'.
    if mark < 40:
        pass
    print('Student Mark:', mark)
