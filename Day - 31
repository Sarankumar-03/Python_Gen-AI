from abc import ABC, abstractmethod
class Animal(ABC):
       @abstractmethod
       def sound(self):
            pass

        
class Dog(Animal):
    def sound(self):
        return "Dog barks"

    
class Cat(Animal):
    def sound(self):
        return "Cat meows"

    
dog = Dog()
cat = Cat()

print(dog.sound())
Dog barks
print(cat.sound())
Cat meows
