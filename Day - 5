name = 'saran'
city = 'chennai'
age = '23'
#String Formatting:
name.format()
'saran'
print('my name is {0} and my age is {1}')
my name is {0} and my age is {1}
#Manual Formatting:
print('my name is {0} and my age is {1}'.format(name,age))
my name is saran and my age is 23
print('my name is {1} and my age is {0}'.format(name,age))
my name is 23 and my age is saran
