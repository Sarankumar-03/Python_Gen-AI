#Pattern/Grid program using tuples and loops:
smart = [(1,2),(1,3),(1,5),(1,6),(2,1),(2,4),(2,7),(3,1),(3,7),(4,2),(4,6),(5,3),(5,5),(6,4)]
def smt():
    for i in range(1,10):
        for j in range(1,10):
            if (i,j) in smart:
                print('+', end=' ')
            else:
                print('.', end=' ')
        print()

        
