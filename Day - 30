#11.STUDENT GRADE CALCULATOR:
def project11():
    n = int(input("How many subjects? "))
    total = 0
    for i in range(n):
        total = total + float(input("Marks for subject " + str(i + 1) + ": "))
    avg = total / n
    print("Total =", total, " Average =", avg)
    if avg >= 90:
        print("Grade A+")
    elif avg >= 80:
        print("Grade A")
    elif avg >= 70:
        print("Grade B")
    elif avg >= 60:
        print("Grade C")
    elif avg >= 50:
        print("Grade D")
    else:
        print("Fail")
