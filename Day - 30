#9.COMPOUND INTEREST CALCULATOR:
def project9():
    p = float(input("Principal amount: "))
    r = float(input("Rate of interest (%): "))
    t = int(input("Time (years): "))
    amount = p
    for year in range(t):
        amount = amount + amount * r / 100
    print("Total Amount =", amount)
    print("Compound Interest =", amount - p)
