#3.NUMBER GUESSING GAME:
def project3():
    secret = random.randint(1, 100)
    tries = 0
    print("I am thinking of a number between 1 and 100")
    while True:
        guess = int(input("Your guess: "))
        tries = tries + 1
        if guess < secret:
            print("Too low")
        elif guess > secret:
            print("Too high")
        else:
            print("Correct! You took", tries, "tries")
            break
