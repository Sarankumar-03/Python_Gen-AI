#18.E-COMMERCE WEBSITE - (shopping in the console)
def project18():
    items = {"shirt": 500, "shoes": 1500, "watch": 2000, "bag": 800}
    cart = []
    total = 0
    while True:
        print("\n1.Show items  2.Add to cart  3.View cart  4.Checkout")
        c = input("Choose: ")
        if c == "1":
            for i in items:
                print(i, "- Rs.", items[i])
        elif c == "2":
            i = input("Item name: ").lower()
            if i in items:
                cart.append(i)
                total = total + items[i]
                print("Added")
            else:
                print("Item not found")
        elif c == "3":
            for i in cart:
                print(i, "- Rs.", items[i])
            print("Total: Rs.", total)
        elif c == "4":
            print("Thank you! Please pay Rs.", total)
            break
