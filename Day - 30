#6.BMI CALCULATOR:
def project6():
    w = float(input("Weight (kg): "))
    h = float(input("Height (meters): "))
    bmi = w / (h * h)
    print("Your BMI =", bmi)
    if bmi < 18.5:
        print("Underweight")
    elif bmi < 40:
        print("Normal")
    elif bmi < 80:
        print("Overweight")
    else:
        print("Obese")
#7.AGE CALCULATOR:
def project7():
    y = int(input("Birth year: "))
    m = int(input("Birth month (1-12): "))
    d = int(input("Birth day: "))
    today = datetime.date.today()
    age = today.year - y
    if today.month < m or (today.month == m and today.day < d):
        age = age - 1
    print("Your age is", age, "years")
#8.SIMPLE INTEREST CALCULATOR:
def project8():
    p = float(input("Principal amount: "))
    r = float(input("Rate of interest (%): "))
