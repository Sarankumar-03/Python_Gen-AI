#Pandas:
#Data Frame:

import pandas as pd

data = {"Name": ['Arun', 'Bala', 'Charan', 'David', 'Ezhil', 'Farhan'], 
        "Age": [20, 30, 26, 22, 28, 24], 
        "Salary": [20000, 25000, 30000, 35000, 40000, 45000]}

df = pd.DataFrame(data)
print("DataFrame:")
print(df)
print('----------------------------------------------------------------')
#head - Print First 5 in the data.
print("Head:")
print(df.head(2))
print('----------------------------------------------------------------')
#Tail - Print Last 5 in the data.
print("Tail:")
print(df.tail())
print('----------------------------------------------------------------')
#info - Print All detailed information about the data.
print("info:")
df.info()
print('----------------------------------------------------------------')
#describe - Print in (.).
print("describe:")
print(df.describe())
print('----------------------------------------------------------------')
print("describe - all:")
print(df.describe(include="all"))
print('----------------------------------------------------------------')
#iloc - Access by position (rows & Colums).
print("iloc:")
print(df.iloc[0:3, 0:2])
print('----------------------------------------------------------------')
#loc - lable the (Rows & Colums).
print("loc[]:")
print(df.loc[0:2, ["Name", "Age"]])
print('----------------------------------------------------------------')

